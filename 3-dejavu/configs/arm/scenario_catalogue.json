{
  "metadata": {
    "name": "Lift Scenarios Catalogue — Multi-Application"
  },
  "monitored_parameters": {
    "object_available":        { "type": "int",   "min_value": 0,    "max_value": 10   },
    "task_started":            { "type": "int",   "min_value": 0,    "max_value": 1    },
    "gripper_width_cm":        { "type": "int",   "min_value": 0,    "max_value": 100  },
    "distance_ee_object_cm":   { "type": "int",   "min_value": 0,    "max_value": 100  },
    "grasp_completed":         { "type": "int",   "min_value": 0,    "max_value": 1    },
    "finger_contacts":         { "type": "int",   "min_value": 0,    "max_value": 5    },
    "grasp_attempts":          { "type": "int",   "min_value": 0,    "max_value": 5    },
    "object_lift_height_cm":   { "type": "int",   "min_value": 0,    "max_value": 100  },
    "distance_object_goal_cm": { "type": "int",   "min_value": 0,    "max_value": 100  },
    "task_aborted":            { "type": "int",   "min_value": 0,    "max_value": 1    },
    "teste":                   { "type": "int",   "min_value": 0,    "max_value": 100  },
    "lateral_friction":        { "type": "float", "min_value": 0.0,  "max_value": 2.0  },
    "grip_pressure":           { "type": "float", "min_value": 0.0,  "max_value": 100.0 },
    "vacuum_level":            { "type": "float", "min_value": 0.0,  "max_value": 100.0 },
    "ambient_temperature":     { "type": "float", "min_value": 0.0,  "max_value": 60.0  },
    "object_secured":          { "type": "int",   "min_value": 0,    "max_value": 1    },
    "joint_torque":            { "type": "float", "min_value": 0.0,  "max_value": 20.0  },
    "motor_temperature":       { "type": "float", "min_value": 0.0,  "max_value": 100.0 },
    "objects_object_1_mass":   { "type": "float", "min_value": 0.0,  "max_value": 20.0  }
  },
  "scenarios": {

    "lift_slip_low_friction": {
      "name": "Lift Slip — Low Friction Surface",
      "given": "object_lift_height_cm < 10 AND finger_contacts < 2 AND lateral_friction <= 0.4",
      "when":  "grasp_completed == 1",
      "do":    "apply_vacuum_assist()",
      "then":  "object_lift_height_cm >= 10 AND finger_contacts >= 2"
    },

    "cobot_lift_grip_pressure": {
      "name": "Cobot Lift Failure — Grip Pressure",
      "given": "object_lift_height_cm < 10 AND grip_pressure < 40",
      "when":  "grasp_completed == 1",
      "do":    "increase_grip_pressure()",
      "then":  "object_lift_height_cm >= 10 AND grip_pressure >= 40"
    },

    "suction_arm_vacuum_loss": {
      "name": "Suction Arm Lift — Vacuum Loss",
      "given": "vacuum_level < 50 AND ambient_temperature > 35",
      "when":  "grasp_completed == 1",
      "do":    "emergency_vacuum_pump()",
      "then":  "vacuum_level >= 70 AND object_secured == 1"
    },

    "parallel_arm_contact_loss": {
      "name": "Parallel Arm Lift — Contact Loss",
      "given": "object_lift_height_cm < 10 AND finger_contacts < 2",
      "when":  "grasp_completed == 1",
      "do":    "reposition_and_regrip()",
      "then":  "object_lift_height_cm >= 10 AND finger_contacts >= 2"
    },

    "lightweight_arm_height_only": {
      "name": "Lightweight Arm Lift — Height Verification Only",
      "given": "object_lift_height_cm < 10 AND finger_contacts < 2",
      "when":  "grasp_completed == 1",
      "do":    "extend_lift_phase()",
      "then":  "object_lift_height_cm >= 12"
    },

    "heavy_duty_arm_motor_overload": {
      "name": "Heavy Duty Arm — Motor Overload During Lift",
      "given": "joint_torque > 8 AND motor_temperature > 60",
      "when":  "grasp_completed == 1",
      "do":    "reduce_lift_speed()",
      "then":  "object_lift_height_cm >= 10 AND joint_torque < 5"
    },

    "cobot_incremental_heavy_transport": {
      "name": "Cobot Industrial — Incremental Heavy Part Transfer",
      "given": "objects_object_1_mass > 3 AND finger_contacts < 2 AND object_lift_height_cm < 10 AND joint_torque > 8",
      "when":  "grasp_completed == 1",
      "do":    "heavy_lift()",
      "then":  "object_lift_height_cm >= 10 AND finger_contacts >= 2 AND distance_object_goal_cm <= 10"
    }

  }
}
