{
  "metadata": {
    "name": "arm_SAS"
  },
  "monitored_parameters": {
    "object_available": {
      "type": "int",
      "min": 0,
      "max": 10
    },
    "task_started": {
      "type": "int",
      "min": 0,
      "max": 1
    },
    "gripper_width_cm": {
      "type": "int",
      "min": 0,
      "max": 100
    },
    "distance_ee_object_cm": {
      "type": "int",
      "min": 0,
      "max": 100
    },
    "grasp_completed": {
      "type": "int",
      "min": 0,
      "max": 1
    },
    "finger_contacts": {
      "type": "int",
      "min": 0,
      "max": 5
    },
    "grasp_attempts": {
      "type": "int",
      "min": 0,
      "max": 5
    },
    "object_lift_height_cm": {
      "type": "int",
      "min": 0,
      "max": 100
    },
    "distance_object_goal_cm": {
      "type": "int",
      "min": 0,
      "max": 100
    },
    "task_aborted": {
      "type": "int",
      "min": 0,
      "max": 1
    },
    "teste": {
      "type": "int",
      "min": 0,
      "max": 100
    }
  },
  "scenarios": {
    "approach_object": {
      "name": "APPROACH_OBJECT",
      "given": "object_available == true AND gripper_width_cm >= 6",
      "when": "task_started == 1",
      "do": "approach_object()",
      "then": "distance_ee_object_cm <= 2"
    },
    "grasp_object": {
      "name": "GRASP_OBJECT",
      "given": "gripper_width_cm >= 6",
      "when": "distance_ee_object_cm <= 2",
      "do": "close_gripper()",
      "then": "grasp_completed == 1 AND finger_contacts >= 2"
    },
    "retry_grasp": {
      "name": "RETRY_GRASP",
      "given": "finger_contacts < 2 AND grasp_attempts < 3",
      "when": "grasp_completed == 1",
      "do": "open_gripper(); realign_gripper(); close_gripper(); attemp_increment()",
      "then": "grasp_completed == 1"
    },
    "safe_abort": {
      "name": "SAFE_ABORT",
      "given": "finger_contacts < 2 AND grasp_attempts >= 3",
      "when": "grasp_completed == 1",
      "do": "open_gripper(); abort_task()",
      "then": "task_aborted == 1"
    },
    "lift_object": {
      "name": "LIFT_OBJECT",
      "given": "finger_contacts >= 2",
      "when": "grasp_completed == 1",
      "do": "lift_object()",
      "then": "object_lift_height_cm >= 10 AND finger_contacts >= 2"
    },
    "transport_object": {
      "name": "TRANSPORT_OBJECT",
      "given": "finger_contacts >= 2",
      "when": "object_lift_height_cm >= 10",
      "do": "transport_to_goal()",
      "then": "distance_object_goal_cm <= 5 AND object_lift_height_cm >= 10 AND finger_contacts >= 2"
    },
    "place_object": {
      "name": "PLACE_OBJECT",
      "given": "object_lift_height_cm >= 10 AND finger_contacts >= 2",
      "when": "distance_object_goal_cm <= 5",
      "do": "lower_object(); open_gripper()",
      "then": "distance_object_goal_cm <= 5 AND gripper_width_cm >= 6"
    }
  },
  "transitions": [
    {
      "from": "approach_object",
      "to": "grasp_object"
    },
    {
      "from": "grasp_object",
      "to": "lift_object"
    },
    {
      "from": "grasp_object",
      "to": "retry_grasp"
    },
    {
      "from": "retry_grasp",
      "to": "lift_object"
    },
    {
      "from": "retry_grasp",
      "to": "safe_abort"
    },
    {
      "from": "lift_object",
      "to": "transport_object"
    },
    {
      "from": "transport_object",
      "to": "place_object"
    },
    {
      "from": "retry_grasp",
      "to": "retry_grasp"
    }
  ]
}